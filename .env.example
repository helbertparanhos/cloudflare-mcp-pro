# Cloudflare API token (required)
# Create at: https://dash.cloudflare.com/profile/api-tokens
# Recommended scopes depend on what you use: Zone:Read, DNS:Edit, Workers Scripts:Edit,
# Workers KV Storage:Edit, Workers R2 Storage:Edit, D1:Edit, Pages:Edit, Account Analytics:Read.
CLOUDFLARE_API_TOKEN=your-api-token-here

# Default account ID (optional). Used when a tool needs an account and you don't pass account_id.
# Find it in the Cloudflare dashboard URL or via the list_accounts tool.
CLOUDFLARE_ACCOUNT_ID=

# Optional: override the API base URL (defaults to https://api.cloudflare.com/client/v4)
# CLOUDFLARE_API_BASE=https://api.cloudflare.com/client/v4
